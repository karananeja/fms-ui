  {
    "function": {
      "description": "Generate a downloadable report (CSV or PDF) the user gets as a link. Kinds: vehicle-status (current status of every vehicle), utilisation (per-vehicle KPIs over the range), driver-performance (per-driver score and KPIs over the range), no-gps (vehicles without GPS now, with the likely cause), requests (driver requests created in the range). PDF is limited to 5000 rows. Default range: the last 7 days.",
      "name": "create_report",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "fleet": {
            "description": "Fleet name or id (includes its sub-fleets).",
            "type": "string",
          },
          "format": {
            "enum": [
              "csv",
              "pdf",
            ],
            "type": "string",
          },
          "from": {
            "description": "Start date as an IST date, YYYY-MM-DD (inclusive).",
            "type": "string",
          },
          "kind": {
            "enum": [
              "vehicle-status",
              "utilisation",
              "driver-performance",
              "no-gps",
              "requests",
            ],
            "type": "string",
          },
          "to": {
            "description": "End date as an IST date, YYYY-MM-DD (inclusive).",
            "type": "string",
          },
        },
        "required": [
          "kind",
          "format",
        ],
        "type": "object",
      },
    },
    "type": "function",
  },
  {
    "function": {
      "description": "Search the drivers the user can see by name or phone fragment, fleet and/or status. Returns up to 25 drivers with their current vehicle, plus the total match count.",
      "name": "find_drivers",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "fleet": {
            "description": "Fleet name or id (includes its sub-fleets).",
            "type": "string",
          },
          "query": {
            "description": "Fragment of the name or phone number.",
            "type": "string",
          },
          "status": {
            "enum": [
              "active",
              "off-duty",
              "disabled",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "type": "function",
  },
  {
    "function": {
      "description": "Search the vehicles the user can see by regno/VIN/device id fragment, current status and/or fleet. Returns at most \`limit\` vehicles (default 20, max 50) with their status, fleet and last update, plus the total match count and counts by status.",
      "name": "find_vehicles",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "fleet": {
            "description": "Fleet name or id (includes its sub-fleets).",
            "type": "string",
          },
          "limit": {
            "description": "Max vehicles to list, 1–50 (default 20).",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
          },
          "query": {
            "description": "Fragment of a regno, VIN, vehicle id or device id.",
            "type": "string",
          },
          "status": {
            "description": "Current derived status.",
            "enum": [
              "running",
              "stopped",
              "immobilized",
              "non-comm",
              "charging",
              "pullout",
              "no-gps",
              "gps-never",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "type": "function",
  },
  {
    "function": {
      "description": "KPI totals for the user's fleets (or one fleet) over a date range: vehicles, distance, drive/idle/downtime hours, uptime %, no-GPS hours, energy, breakdowns, harsh events, events per 100 km and driver score, plus the current status counts. Default range: the last 7 days.",
      "name": "fleet_summary",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "fleet": {
            "description": "Fleet name or id (includes its sub-fleets).",
            "type": "string",
          },
          "from": {
            "description": "Start date as an IST date, YYYY-MM-DD (inclusive).",
            "type": "string",
          },
          "to": {
            "description": "End date as an IST date, YYYY-MM-DD (inclusive).",
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "type": "function",
  },
  {
    "function": {
      "description": "Read one of the user's own dashboards: title, description, version and every widget with its settings, in reading order. \`dashboard\` is an id or a title (exact or partial); in a dashboard's chat it defaults to that dashboard. Without it in the global chat, lists the user's dashboards.",
      "name": "get_dashboard",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "dashboard": {
            "description": "Dashboard id or title.",
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "type": "function",
  },
  {
    "function": {
      "description": "One driver's details: fleet, status, current vehicle, open requests and KPIs over the last 30 days (distance, score, harsh events). Give the name (or a unique part of it) or the driver id.",
      "name": "get_driver",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Driver id.",
            "type": "string",
          },
          "name": {
            "description": "Driver name, or a unique part of it.",
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "type": "function",
  },
  {
    "function": {
      "description": "One vehicle's current state: status, location, speed, SOC, range, odometer, ignition, last GPS/CAN times, the assigned driver and, when it has no GPS, the likely cause. Give the regno (preferred) or the vehicleId.",
      "name": "get_vehicle",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "regno": {
            "description": "Registration number, e.g. MH12AB1234.",
            "type": "string",
          },
          "vehicleId": {
            "description": "Internal vehicle id.",
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "type": "function",
  },
  {
    "function": {
      "description": "Driver requests (breakdown, replacement, RSA) in the user's fleets, newest first, filtered by type, status, fleet and creation date. Returns counts by type and status and up to 25 requests. Without dates it covers all requests.",
      "name": "list_requests",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "fleet": {
            "description": "Fleet name or id (includes its sub-fleets).",
            "type": "string",
          },
          "from": {
            "description": "Created on or after as an IST date, YYYY-MM-DD (inclusive).",
            "type": "string",
          },
          "status": {
            "enum": [
              "open",
              "acknowledged",
              "dispatched",
              "waiting",
              "suggested",
              "approved",
              "assigned",
              "resolved",
              "closed",
              "rejected",
            ],
            "type": "string",
          },
          "to": {
            "description": "Created on or before as an IST date, YYYY-MM-DD (inclusive).",
            "type": "string",
          },
          "type": {
            "enum": [
              "breakdown",
              "replacement",
              "rsa",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "type": "function",
  },

# MapLibre style URL. Dev default: OpenFreeMap dark style (no API key).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# DS3 light theme basemap
VITE_MAP_STYLE_URL_LIGHT=https://tiles.openfreemap.org/styles/positron
# Light basemap for the public share page /share/:token (F10). Dev default: OpenFreeMap positron.
VITE_SHARE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Dev-only auto sign-in (F04, until F02 ships a login page). Ignored in production builds.
VITE_DEV_LOGIN_EMAIL=superadmin@fms.local
VITE_DEV_LOGIN_PASSWORD=Admin@123

# ---- Mock server (F01) ----
# Port the mock server listens on; the Vite dev server proxies /api and /ws here.
MOCK_PORT=4000
# Vite dev server port (e2e and parallel worktrees override it).
VITE_PORT=5173
# Seed for the deterministic data generator (same seed + time = same data).
MOCK_SEED=42
# Number of synthetic vehicles (max 1000000).
MOCK_VEHICLES=100000
# How often each vehicle reports, in ms (±20% jitter). Non-comm vehicles never report.
MOCK_VEHICLE_INTERVAL_MS=10000
# How often batched deltas are flushed to WS subscribers, in ms.
MOCK_BATCH_MS=500
# Rows per snapshot chunk (and max rows per delta message).
MOCK_SNAPSHOT_CHUNK=5000
# Fastify log level (info prints reset/invite links to the console).
MOCK_LOG_LEVEL=info

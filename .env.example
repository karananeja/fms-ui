# MapLibre style URL. Dev default: OpenFreeMap dark style (no API key).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# DS3 light theme basemap
VITE_MAP_STYLE_URL_LIGHT=https://tiles.openfreemap.org/styles/positron
# Light basemap for the public share page /share/:token (F10). Dev default: OpenFreeMap positron.
VITE_SHARE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Dev-only auto sign-in (F04, until F02 ships a login page). Ignored in production builds.
VITE_DEV_LOGIN_EMAIL=superadmin@fms.local
VITE_DEV_LOGIN_PASSWORD=Admin@123

# ---- Mock server (F01) ----
# Port the mock server listens on; the Vite dev server proxies /api and /ws here.
MOCK_PORT=4000
# Vite dev server port (e2e and parallel worktrees override it).
VITE_PORT=5173
# Seed for the deterministic data generator (same seed + time = same data).
MOCK_SEED=42
# Number of synthetic vehicles (max 1000000).
MOCK_VEHICLES=100000
# How often each vehicle reports, in ms (±20% jitter). Non-comm vehicles never report.
MOCK_VEHICLE_INTERVAL_MS=10000
# How often batched deltas are flushed to WS subscribers, in ms.
MOCK_BATCH_MS=500
# Rows per snapshot chunk (and max rows per delta message).
MOCK_SNAPSHOT_CHUNK=5000
# Fastify log level (info prints reset/invite links to the console).
MOCK_LOG_LEVEL=info
# SQLite file for dashboards, accounts, sessions and admin data (F18, F22). Default:
# mock-server/data/fms.db; `:memory:` for a throwaway run. Delete the file to start over.
MOCK_DB=
# 1 = wipe the database (incl. dashboards) and re-seed it from MOCK_SEED at start (F22).
# Needed after changing MOCK_SEED or MOCK_VEHICLES: a database seeded otherwise is refused.
MOCK_DB_RESET=

# ---- Fleet assistant / AI dashboards (F17, F19, F21) ----
# Copy to `.env` (git-ignored); the mock server reads it at startup. Keys stay on the server only.
# Provider: xai | openai | anthropic | fake. Unset → the first provider whose key is set
# (anthropic, then openai, then xai); no key → the fake model in dev, "not configured" in production.
FMS_ASSISTANT_PROVIDER=
# Model id for the chosen provider. Required for xai/openai; anthropic defaults to claude-opus-5-5.
# Examples: grok-4 (xai), gpt-5 (openai), claude-opus-5-5 (anthropic).
FMS_ASSISTANT_MODEL=
# xAI Grok (OpenAI-compatible API, https://api.x.ai/v1)
XAI_API_KEY=
# OpenAI (https://api.openai.com/v1)
OPENAI_API_KEY=
# Anthropic Claude (@anthropic-ai/sdk, D-105)
ANTHROPIC_API_KEY=
# Optional: override the provider's API base URL (e.g. a proxy). Leave empty for the default.
FMS_ASSISTANT_BASE_URL=
# 1 = always use the scripted fake model (tests/demos), 0 = never fall back to it.
FMS_ASSISTANT_FAKE=
